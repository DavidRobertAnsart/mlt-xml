{
  "name": "mlt-xml",
  "version": "2.0.3",
  "description": "A module to construct Media Lovin' Toolkit (MLT) projects and export them in XML.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidRobertAnsart/mlt-xml"
  },
  "author": "David Robert-Ansart <david.robertansart@gmail.com>",
  "license": "MIT",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "typings": "lib/index.d.ts",
  "keywords": [
    "mlt",
    "melt",
    "xml",
    "mltToXml"
  ],
  "files": [
    "lib"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "rollup -c",
    "lint": "eslint . --fix",
    "typescript": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@types/node": "26.1.1",
    "@typescript-eslint/parser": "8.63.0",
    "esbuild": "0.28.1",
    "esbuild-runner": "2.2.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.5",
    "rollup": "4.62.2",
    "rollup-plugin-dts": "6.4.1",
    "rollup-plugin-esbuild": "6.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  }
}
